PORT=3002
NODE_ENV=development
MONGO_URL=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
TOKEN_KEY=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:3000
# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Stock Platform <your_email@gmail.com>
# Alternatively, set CORS_ORIGIN to a comma-separated list:
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
